{
  "name": "lowkkey-showroom-local",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/v1/*",
      "/mcp",
      "/.well-known/*",
      "/authorize",
      "/oauth/*",
      "/healthz"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lowkkey-showroom-local",
      "database_id": "33333333-3333-4333-8333-333333333333",
      "remote": false,
      "migrations_dir": "db/showroom-migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "22222222-2222-4222-8222-222222222222"
    }
  ],
  "observability": {
    "enabled": false
  }
}
