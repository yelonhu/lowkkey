{
  "name": "lowkkey",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [{"pattern": "lowkkey.example.com/*", "zone_name": "example.com"}],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/mcp", "/.well-known/*", "/authorize", "/oauth/*", "/healthz"]
  },
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://lowkkey.example.com",
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "lowkkey-production",
    "database_id": "11111111-1111-4111-8111-111111111111",
    "migrations_dir": "db/migrations"
  }],
  "kv_namespaces": [{"binding": "OAUTH_KV", "id": "22222222-2222-4222-8222-222222222222"}]
}
