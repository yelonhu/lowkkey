#!/bin/sh
set -eu
umask 077
cd "$(dirname "$0")/.."
case "$(/usr/bin/uname -sm)" in 'Darwin arm64') ;; *) echo 'M0 supports macOS arm64 only.' >&2; exit 1 ;; esac
mkdir -p .toolchain .cache/npm .local/config .local/state .local/test-browser .data/dev .data/backups .logs .tmp .artifacts
export TMPDIR="$PWD/.tmp"
export XDG_CONFIG_HOME="$PWD/.local/config" XDG_CACHE_HOME="$PWD/.cache" XDG_STATE_HOME="$PWD/.local/state"
export npm_config_cache="$PWD/.cache/npm" npm_config_userconfig="$PWD/.local/config/npmrc" npm_config_globalconfig="$PWD/.local/config/npm-globalrc"
export npm_config_audit=false npm_config_fund=false npm_config_update_notifier=false
export PLAYWRIGHT_BROWSERS_PATH="$PWD/.toolchain/browsers"
unset NODE_OPTIONS NODE_PATH npm_config_prefix NPM_CONFIG_PREFIX
node_version=24.21.0
archive="node-v$node_version-darwin-arm64.tar.gz"
checksum=bed7eea5325e1108f32ce5228ddd6a5f0f08a499ee42aa7442aea583702f6057
if [ ! -f ".cache/$archive" ]; then
  /usr/bin/curl -q --fail --silent --show-error --location --proto '=https' --tlsv1.2 "https://nodejs.org/dist/v$node_version/$archive" -o ".cache/$archive.part"
  mv ".cache/$archive.part" ".cache/$archive"
fi
actual=$(/usr/bin/shasum -a 256 ".cache/$archive")
actual=${actual%% *}
if [ "$actual" != "$checksum" ]; then echo 'Node checksum mismatch; installation stopped.' >&2; exit 1; fi
if [ ! -x ".toolchain/node-v$node_version-darwin-arm64/bin/node" ]; then
  /usr/bin/tar -xzf ".cache/$archive" -C .toolchain
fi
export PATH="$PWD/.toolchain/node-v$node_version-darwin-arm64/bin:/usr/bin:/bin:/usr/sbin:/sbin"
node --version
if [ -f package-lock.json ]; then
  node scripts/bootstrap-dependencies.mjs
else
  echo 'Pinned runtime ready; dependency lockfile has not been authored yet.'
fi
