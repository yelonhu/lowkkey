#!/bin/sh
set -eu
project_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
node_binary="$project_root/.toolchain/node-v24.21.0-darwin-arm64/bin/node"
"$project_root/scripts/fence" local "$node_binary" "$project_root/scripts/clean-prepare.mjs"
cd "$project_root/.artifacts/clean-room"
mkdir -p .logs
step=0
run_step() {
  step=$((step + 1))
  status=0
  started=$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')
  "$@" > ".logs/verification-$step.log" 2>&1 || status=$?
  printf '{"at":"%s","step":%s,"command":"%s","exitCode":%s}\n' "$started" "$step" "$*" "$status" >> .logs/verification.jsonl
  cat ".logs/verification-$step.log"
  if [ "$status" != 0 ]; then exit "$status"; fi
}
run_step ./scripts/bootstrap
run_step ./scripts/bootstrap
run_step ./scripts/run probe:env
run_step ./scripts/run verify:bootstrap
run_step ./scripts/run migrate:local
run_step ./scripts/run migrate:local
run_step ./scripts/run check
run_step ./scripts/run verify:dev
run_step ./scripts/run test
run_step ./scripts/run test:e2e
run_step ./scripts/run build
run_step ./scripts/run verify:secrets
run_step ./scripts/fence local .toolchain/node-v24.21.0-darwin-arm64/bin/node scripts/clean-finish.mjs
