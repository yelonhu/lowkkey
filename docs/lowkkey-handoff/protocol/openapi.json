{
  "openapi": "3.1.0",
  "info": {
    "title": "lowkkey API",
    "version": "4.0.0",
    "description": "见 INTERFACE.md。客户网页使用应用会话；Access 仅保留管理和兼容环境；Remote MCP 使用 OAuth。客户写入必须携带 X-Lowkkey-Account。scope 见各操作的 x-scopes。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
