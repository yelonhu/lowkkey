          "load": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000
          },
          "unit": {
            "type": "string",
            "enum": [
              "lb",
              "kg"
            ]
          },
          "loadKind": {
            "type": "string",
            "enum": [
              "external",
              "assist",
              "bodyweight"
            ]
          },
          "reps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "rir": {
            "anyOf": [
