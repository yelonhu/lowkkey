          }
        },
        "required": [
          "date",
          "raw_text",
          "sets",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "TrainingSet": {
        "type": "object",
        "properties": {
          "exerciseId": {
            "type": "string",
            "enum": [
              "bench_press",
              "incline_db_press",
              "dip",
              "pec_deck",
              "cable_fly",
              "pull_up",
              "lat_pulldown",
              "seated_row",
              "barbell_row",
              "face_pull",
              "db_shoulder_press",
              "lateral_raise",
              "ez_curl",
              "db_curl",
              "skull_crusher",
              "triceps_pushdown",
              "back_squat",
              "hack_squat",
              "leg_press",
              "romanian_deadlift",
              "seated_leg_curl",
              "leg_extension",
              "hip_adduction",
              "calf_raise"
