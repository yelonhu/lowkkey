{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "lowkkey": {
      "type": "streamable-http",
      "url": "{{origin}}/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["read"],
            "defaultScopes": ["read", "write", "notes:write"]
          }
        }
      }
    }
  }
}
