  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/v1/*", "/mcp", "/.well-known/*", "/authorize", "/oauth/*", "/healthz"] },
